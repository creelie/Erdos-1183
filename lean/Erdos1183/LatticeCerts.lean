/-- A listed family is a set of distinct masks below `2^11`, closed under `|||` and `&&&`, whose
member sizes appear in the listed sizes. -/
def certOK (p : List ℕ × List ℕ) : Bool :=
  closedB p.1 && decide p.1.Nodup && p.1.all (fun m => decide (m < 2048) && p.2.contains (pc m))

/-- The size colouring `b` is beaten by a listed family. -/
def coverB (b : List Bool) : Bool :=
  certs.any fun p =>
    let c := b.getD (p.2.headD 0) false
    p.2.all (fun v => b.getD v false == c) &&
      decide ((List.range 12).countP (fun v => b.getD v false == c) < p.1.length)

set_option maxRecDepth 100000 in
theorem certs_ok : certs.all certOK = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem cover_ok : ∀ b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 : Bool,
    coverB [false, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11] = true := by decide +kernel

